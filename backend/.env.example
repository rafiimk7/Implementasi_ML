# =============================================================================
# Backend Environment Variables — Prediksi ATM
# =============================================================================
# Salin file ini ke .env dan isi nilainya:
#   cp .env.example .env
#
# Atau export langsung ke shell sebelum menjalankan script:
#   export DB_PASSWORD=secret
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE (MySQL / MariaDB)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=PT_BGI


# -----------------------------------------------------------------------------
# ML PIPELINE — TABEL SUMBER
# -----------------------------------------------------------------------------
# Nama tabel data mentah ATM di MySQL (bisa berbeda per periode).
# Contoh: data_mei2026, data_maret2026
SOURCE_TABLE=data_mei2026


# -----------------------------------------------------------------------------
# FITUR KALENDER CERDAS
# -----------------------------------------------------------------------------

# Tanggal gajian per bulan.
# Nilai yang didukung:
#   "25"           → tanggal 25 (atau angka lain); jika jatuh di akhir pekan,
#                    otomatis digeser ke hari Jumat terdekat sebelumnya
#   "last_workday" → hari kerja terakhir bulan itu
PAYDAY_DATE=25

# API key dari https://calendarific.com untuk data libur nasional Indonesia.
# Daftar gratis tersedia di: https://calendarific.com/signup
# Jika dikosongkan, sistem memakai daftar libur hardcode sebagai fallback.
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# Kode negara ISO-3166 alpha-2 untuk Calendarific API.
# Default: ID (Indonesia). Ganti jika deploy di negara lain.
HOLIDAY_COUNTRY=ID


# -----------------------------------------------------------------------------
# SCHEDULER
# -----------------------------------------------------------------------------
# Interval prediksi realtime incremental (menit).
# Scheduler hanya memproses TID dengan data RAW baru — tidak membaca
# seluruh data historis setiap siklus.
PREDICT_INTERVAL_MINUTES=15

# Window histori untuk feature engineering incremental (hari).
# Nilai minimum 31: rolling_30d butuh 30 hari data + 1 hari shift.
# Jangan kurangi di bawah 31 — rolling_30d akan menghasilkan nilai
# yang berbeda dari saat training dan merusak konsistensi inferensi.
PREDICT_WINDOW_DAYS=31

# Jadwal retraining model mingguan (full pipeline: preprocessing + training).
# RETRAIN_DAY_OF_WEEK: mon/tue/wed/thu/fri/sat/sun
# RETRAIN_HOUR       : jam dalam format 24 jam (0-23)
RETRAIN_DAY_OF_WEEK=sun
RETRAIN_HOUR=2
